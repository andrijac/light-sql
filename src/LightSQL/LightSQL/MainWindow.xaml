<Window x:Class="LightSQL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LightSQL.ViewModels"
        xmlns:views="clr-namespace:LightSQL.Views"
        Title="LightSQL"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ExecuteQueryCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewQueryCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveQueryCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- Dropdown menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Query" InputGestureText="Ctrl+N" Command="{Binding NewQueryCommand}" />
                <MenuItem Header="_Open Query" ItemsSource="{Binding SavedQueries}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Name}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenQueryCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="_Save Query" InputGestureText="Ctrl+S" Command="{Binding SaveQueryCommand}" />
                <MenuItem Header="_Refresh Saved Queries" Command="{Binding RefreshSavedQueriesCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitMenu_Click" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" Command="ApplicationCommands.Undo" />
                <MenuItem Header="Redo" Command="ApplicationCommands.Redo" />
                <Separator />
                <MenuItem Header="Cut" Command="ApplicationCommands.Cut" />
                <MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
                <MenuItem Header="Paste" Command="ApplicationCommands.Paste" />
                <Separator />
                <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll" />
            </MenuItem>

            <MenuItem Header="_Query">
                <MenuItem Header="_Execute" InputGestureText="F5" Command="{Binding ExecuteQueryCommand}" />
                <MenuItem Header="_Cancel" Command="{Binding CancelCommand}" />
            </MenuItem>

            <MenuItem Header="_Database">
                <MenuItem Header="_Connect..." Command="{Binding ConnectCommand}" />
                <MenuItem Header="_Disconnect" Command="{Binding DisconnectCommand}" />
                <Separator />
                <MenuItem Header="_New Database..." Command="{Binding ObjectExplorer.NewDatabaseCommand}" />
                <MenuItem Header="_Refresh Databases" Command="{Binding ObjectExplorer.RefreshCommand}" />
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="_Options..." Command="{Binding ShowOptionsCommand}" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_About LightSQL" Click="AboutMenu_Click" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Connect" Command="{Binding ConnectCommand}" ToolTip="Connect to a server" />
                <Separator />
                <TextBlock Text="Database:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox Width="200"
                          ItemsSource="{Binding Databases}"
                          SelectedItem="{Binding ActiveDatabase}"
                          IsEnabled="{Binding IsConnected}"
                          ToolTip="Active database" />
                <Separator />
                <Button Content="Execute (F5)"
                        Command="{Binding ExecuteQueryCommand}"
                        Foreground="DarkGreen"
                        FontWeight="Bold"
                        ToolTip="Execute the query or selection" />
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        ToolTip="Cancel the running query" />
                <Separator />
                <Button Content="Save Query"
                        Command="{Binding SaveQueryCommand}"
                        ToolTip="Save the query to your personal folder" />
            </ToolBar>
        </ToolBarTray>

        <!-- Footer status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ConnectionStatus}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ActiveDatabase, TargetNullValue='(no database)'}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding RowCountText}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ElapsedText}" Margin="0,0,12,0" />
                    <TextBlock>
                        <Run Text="Ln " /><Run Text="{Binding CaretLine}" /><Run Text=", Col " /><Run Text="{Binding CaretColumn}" />
                    </TextBlock>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Main content: Object Explorer | Editor + Results -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="120" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Object Explorer -->
            <TreeView x:Name="ObjectTree"
                      Grid.Column="0"
                      ItemsSource="{Binding ObjectExplorer.RootNodes}">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Title}" />
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Tag" Value="{Binding DataContext.ObjectExplorer, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu DataContext="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="New Query"
                                              Command="{Binding NewQueryCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Select Top 1000"
                                              Command="{Binding SelectTopCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="New Database..."
                                              Command="{Binding NewDatabaseCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Drop..."
                                              Command="{Binding DropCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="Refresh"
                                              Command="{Binding RefreshCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#FFE0E0E0" />

            <!-- Editor over Results -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="80" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="1*" MinHeight="60" />
                </Grid.RowDefinitions>

                <views:SqlEditorControl x:Name="SqlEditor"
                                        Grid.Row="0"
                                        DocumentText="{Binding EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedText="{Binding SelectedText, Mode=OneWayToSource}"
                                        CaretLine="{Binding CaretLine, Mode=OneWayToSource}"
                                        CaretColumn="{Binding CaretColumn, Mode=OneWayToSource}" />

                <GridSplitter Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#FFE0E0E0" />

                <TabControl Grid.Row="2"
                            SelectedIndex="{Binding Results.SelectedTabIndex}">
                    <TabItem Header="Results">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Results.ResultViews}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DataGrid ItemsSource="{Binding}"
                                                  AutoGenerateColumns="True"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  MaxHeight="400"
                                                  Margin="0,0,0,8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Messages">
                        <TextBox Text="{Binding Results.Messages, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
