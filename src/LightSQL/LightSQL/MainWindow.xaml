<Window x:Class="LightSQL.MainWindow"
        Style="{DynamicResource Theme.WindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LightSQL.ViewModels"
        xmlns:views="clr-namespace:LightSQL.Views"
        xmlns:converters="clr-namespace:LightSQL.Converters"
        xmlns:behaviors="clr-namespace:LightSQL.Behaviors"
        xmlns:controls="clr-namespace:LightSQL.Controls"
        Title="{Binding SelectedTab.Header, StringFormat='{}{0} - LightSQL', FallbackValue='LightSQL', TargetNullValue='LightSQL'}"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragOver="OnWindowPreviewDragOver"
        PreviewDrop="OnWindowPreviewDrop"
        Closing="OnWindowClosing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
        <converters:ObjectExplorerIconConverter x:Key="ObjectExplorerIcon" />
        <converters:DatabaseObjectTypeToVisibilityConverter x:Key="DatabaseObjectTypeToVisibility" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ExecuteQueryCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewQueryCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveFileAsCommand}" />
        <KeyBinding Key="F4" Modifiers="Control" Command="{Binding CloseQueryCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- Dropdown menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Query" InputGestureText="Ctrl+N" Command="{Binding NewQueryCommand}" />
                <MenuItem Header="_Open File..." InputGestureText="Ctrl+O" Command="{Binding OpenFileCommand}" />
                <Separator />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveFileCommand}" />
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveFileAsCommand}" />
                <Separator />
                <MenuItem Header="_Close" InputGestureText="Ctrl+F4" Command="{Binding CloseQueryCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitMenu_Click" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" Command="ApplicationCommands.Undo" />
                <MenuItem Header="Redo" Command="ApplicationCommands.Redo" />
                <Separator />
                <MenuItem Header="Cut" Command="ApplicationCommands.Cut" />
                <MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
                <MenuItem Header="Paste" Command="ApplicationCommands.Paste" />
                <Separator />
                <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll" />
            </MenuItem>

            <MenuItem Header="_Query">
                <MenuItem Header="_Execute" InputGestureText="F5" Command="{Binding ExecuteQueryCommand}" />
                <MenuItem Header="_Cancel" Command="{Binding CancelCommand}" />
            </MenuItem>

            <MenuItem Header="_Database">
                <MenuItem Header="_Connect..." Command="{Binding ConnectCommand}" />
                <MenuItem Header="_Disconnect" Command="{Binding DisconnectCommand}" />
                <Separator />
                <MenuItem Header="_New Database..." Command="{Binding ObjectExplorer.NewDatabaseCommand}" />
                <MenuItem Header="_Refresh Databases" Command="{Binding ObjectExplorer.RefreshCommand}" />
                <Separator />
                <MenuItem Header="Start _MCP Server"
                          Command="{Binding StartMcpServerCommand}"
                          ToolTip="Start an MCP server locked to the selected database so AI clients (Claude, Codex) can query it" />
                <MenuItem Header="Database _Metadata..."
                          Command="{Binding EditDatabaseMetadataCommand}"
                          ToolTip="Paste schema/semantic metadata (JSON) for a database; it is sent to AI clients as extra instructions" />
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="Metadata Extraction _Prompt..."
                          Command="{Binding ShowMetadataPromptCommand}"
                          ToolTip="Show the AI prompt that generates database metadata JSON from a code repository" />
                <Separator />
                <MenuItem Header="_Options..." Command="{Binding ShowOptionsCommand}" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_About LightSQL" Click="AboutMenu_Click" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Connect" Command="{Binding ConnectCommand}" ToolTip="Connect to a server" />
                <Separator />
                <TextBlock Text="Database:" VerticalAlignment="Center" Margin="4,0" />
                <!-- Each query tab has its own database; this shows/changes the selected tab's. -->
                <ComboBox Width="200"
                          ItemsSource="{Binding Databases}"
                          SelectedItem="{Binding SelectedQueryTab.ActiveDatabase}"
                          IsEnabled="{Binding IsConnected}"
                          ToolTip="Database of the current query tab" />
                <Button Content="Start MCP"
                        Command="{Binding StartMcpServerCommand}"
                        Margin="4,0,0,0"
                        ToolTip="Start an MCP server locked to the selected database (AI clients such as Claude or Codex can then query it)" />
                <Separator />
                <Button Content="Execute (F5)"
                        Command="{Binding ExecuteQueryCommand}"
                        Foreground="{DynamicResource Theme.SuccessForeground}"
                        FontWeight="Bold"
                        ToolTip="Execute the query or selection" />
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        ToolTip="Cancel the running query" />
                <Separator />
                <Button Content="Open"
                        Command="{Binding OpenFileCommand}"
                        ToolTip="Open a .sql file (Ctrl+O)" />
                <Button Content="Save"
                        Command="{Binding SaveFileCommand}"
                        ToolTip="Save the query to its file (Ctrl+S)" />
            </ToolBar>
        </ToolBarTray>

        <!-- Footer status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ConnectionStatus}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedQueryTab.ActiveDatabase, TargetNullValue='(no database)', FallbackValue='(no database)'}" />
            </StatusBarItem>
            <!-- Execution details of the selected query tab. -->
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal"
                            DataContext="{Binding SelectedQueryTab}"
                            Visibility="{Binding DataContext.IsQueryTabSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{Binding ExecutionStatus}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding RowCountText}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ElapsedText}" Margin="0,0,12,0" />
                    <TextBlock>
                        <Run Text="Ln " /><Run Text="{Binding CaretLine, Mode=OneWay}" /><Run Text=", Col " /><Run Text="{Binding CaretColumn, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Main content: Object Explorer | Editor + Results -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="120" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Object Explorer. A right-click selects the clicked node before its
                 context menu opens. -->
            <TreeView x:Name="ObjectTree"
                      Grid.Column="0"
                      behaviors:TreeViewRightClickSelection.IsEnabled="True"
                      ItemsSource="{Binding ObjectExplorer.RootNodes}">
                <TreeView.Resources>
                    <!-- Each node shows an icon for its object type (folders open while
                         expanded) followed by its title. -->
                    <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16"
                                   Height="16"
                                   Margin="0,1,4,1"
                                   VerticalAlignment="Center">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource ObjectExplorerIcon}">
                                        <Binding Path="ObjectType" />
                                        <Binding Path="IsExpanded" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                            <TextBlock Text="{Binding Title}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ObjectType}" Value="Placeholder">
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.SecondaryForeground}" />
                                                <Setter Property="FontStyle" Value="Italic" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ObjectType}" Value="Error">
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.ErrorForeground}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <!-- BasedOn keeps the themed look; only the bindings and menu are added. -->
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Tag" Value="{Binding DataContext.ObjectExplorer, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu DataContext="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="New Query"
                                              Command="{Binding NewQueryCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Select Top 1000"
                                              Command="{Binding SelectTopCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="New Database..."
                                              Command="{Binding NewDatabaseCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Drop..."
                                              Command="{Binding DropCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator Visibility="{Binding PlacementTarget.DataContext.ObjectType, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource DatabaseObjectTypeToVisibility}, ConverterParameter=Database}" />
                                    <MenuItem Header="Start MCP Server"
                                              ToolTip="Start an MCP server locked to this database"
                                              Command="{Binding StartMcpServerCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Visibility="{Binding PlacementTarget.DataContext.ObjectType, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource DatabaseObjectTypeToVisibility}, ConverterParameter=Database}" />
                                    <Separator />
                                    <MenuItem Header="Refresh"
                                              Command="{Binding RefreshCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />

            <!-- Query tabs: a header strip above the selected tab's editor + results -->
            <DockPanel Grid.Column="2">

                <!-- Tab strip. The TabControl is re-templated to show only the headers;
                     the content is hosted below so each tab keeps its own live editor. -->
                <TabControl x:Name="QueryTabStrip"
                            DockPanel.Dock="Top"
                            ItemsSource="{Binding Tabs}"
                            SelectedItem="{Binding SelectedTab}"
                            MouseUp="QueryTabStrip_MouseUp">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Border BorderBrush="{DynamicResource Theme.ControlBorder}" BorderThickness="0,0,0,1" Background="{DynamicResource Theme.TabStripBackground}">
                                <TabPanel IsItemsHost="True" Margin="2,2,2,-1" />
                            </Border>
                        </ControlTemplate>
                    </TabControl.Template>

                    <TabControl.Resources>
                        <!-- Query tab header: name (with * when modified), running indicator, close button. -->
                        <DataTemplate DataType="{x:Type vm:QueryTabViewModel}">
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                                <TextBlock Text=" (executing)"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource Theme.SecondaryForeground}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibility}}" />
                                <Button Content="✕"
                                        Margin="6,0,0,0"
                                        Padding="3,0"
                                        FontSize="10"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        ToolTip="Close (Ctrl+F4)"
                                        Command="{Binding DataContext.CloseQueryCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>

                        <!-- MCP server tab header: state dot (green running, grey stopped,
                             red failed), name with port, close button (stops the server). -->
                        <DataTemplate DataType="{x:Type vm:McpServerTabViewModel}">
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Theme.SecondaryForeground}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Running">
                                                    <Setter Property="Fill" Value="{DynamicResource Theme.SuccessForeground}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                    <Setter Property="Fill" Value="{DynamicResource Theme.ErrorForeground}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                                <Button Content="✕"
                                        Margin="6,0,0,0"
                                        Padding="3,0"
                                        FontSize="10"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        ToolTip="Close and stop the server"
                                        Command="{Binding DataContext.CloseQueryCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>

                        <!-- Query tab: right-click menu. BasedOn keeps the themed look. -->
                        <Style x:Key="QueryTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu DataContext="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Save"
                                                  InputGestureText="Ctrl+S"
                                                  Command="{Binding SaveFileCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Save As..."
                                                  Command="{Binding SaveFileAsCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="Close"
                                                  InputGestureText="Ctrl+F4"
                                                  Command="{Binding CloseQueryCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Close All But This"
                                                  Command="{Binding CloseOtherQueriesCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- MCP server tab: right-click menu. BasedOn keeps the themed look. -->
                        <Style x:Key="McpServerTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu DataContext="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Start Server"
                                                  Command="{Binding PlacementTarget.DataContext.StartServerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Stop Server"
                                                  Command="{Binding PlacementTarget.DataContext.StopServerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Copy Endpoint URL"
                                                  Command="{Binding PlacementTarget.DataContext.CopyEndpointCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="Close"
                                                  InputGestureText="Ctrl+F4"
                                                  Command="{Binding CloseQueryCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Close All But This"
                                                  Command="{Binding CloseOtherQueriesCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- Each kind of tab gets its own header style and right-click menu. -->
                    <TabControl.ItemContainerStyleSelector>
                        <controls:DocumentTabStyleSelector QueryTabStyle="{StaticResource QueryTabItemStyle}"
                                                           McpServerTabStyle="{StaticResource McpServerTabItemStyle}" />
                    </TabControl.ItemContainerStyleSelector>
                </TabControl>

                <Grid>
                    <!-- One view per open tab, stacked; only the selected one is visible.
                         Hidden views stay alive (undo history, caret, scroll). The view is
                         chosen by the tab's type: a query editor or an MCP server page. -->
                    <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type vm:QueryTabViewModel}">
                                <views:QueryTabView Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibility}}" />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:McpServerTabViewModel}">
                                <views:McpServerTabView Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibility}}" />
                            </DataTemplate>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Shown when every tab has been closed. -->
                    <TextBlock Text="No query is open. Press Ctrl+N for a new query or Ctrl+O to open a file."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.SecondaryForeground}"
                               Visibility="{Binding HasTabs, Converter={StaticResource InverseBooleanToVisibility}}" />
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
