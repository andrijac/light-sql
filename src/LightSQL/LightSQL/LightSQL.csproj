<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>LightSQL</RootNamespace>
    <AssemblyName>LightSQL</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQL editor: syntax highlighting, line numbers, caret line/column tracking. -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <!-- Microsoft SQL Server connectivity (SqlServerDatabaseProvider). -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- PostgreSQL connectivity (PostgreSqlDatabaseProvider). -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- MySQL / MariaDB connectivity (MySqlDatabaseProvider); fully-async ADO.NET driver. -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <!-- Lightweight MVVM: ObservableObject, [ObservableProperty], [RelayCommand]. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Dependency injection for wiring services and view models at startup. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <!-- MCP server hosted in Kestrel (official C# SDK) for AI clients. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.1" />
    <!-- Note: Windows DPAPI (System.Security.Cryptography.ProtectedData) is provided
         by the net10.0-windows framework and does not need a package reference. -->
  </ItemGroup>

  <ItemGroup>
    <!-- T-SQL highlighting definition loaded at runtime via HighlightingManager. -->
    <EmbeddedResource Include="Editor\SqlSyntax.xshd" />
    <!-- The database-metadata extraction prompt shown in Tools -> Metadata Extraction Prompt. -->
    <EmbeddedResource Include="Resources\MetadataExtractionPrompt.txt" />
  </ItemGroup>

</Project>
