<UserControl x:Class="LightSQL.Views.McpServerTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The content of one MCP server tab (DataContext: McpServerTabViewModel):
         server details and controls, ready-to-copy AI client setup, and a log of
         the tool calls AI clients made. -->
    <UserControl.Resources>
        <!-- Label column of the details grid. -->
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.SecondaryForeground}" />
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Value column of the details grid. -->
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Read-only, selectable text for URLs, commands and config snippets. -->
        <Style x:Key="CodeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- Title with the server state. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Start Server"
                        Padding="12,3"
                        Command="{Binding StartServerCommand}"
                        ToolTip="Start the server again (it may get a different port)" />
                <Button Content="Stop Server"
                        Margin="6,0,0,0"
                        Padding="12,3"
                        Command="{Binding StopServerCommand}"
                        ToolTip="Stop the server and free its port; the tab stays open" />
            </StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center">
                <Run Text="MCP Server" />
                <Run Text="–" Foreground="{DynamicResource Theme.SecondaryForeground}" />
                <Run Text="{Binding ServerName, Mode=OneWay}" />
            </TextBlock>
        </DockPanel>

        <!-- Details (left) and AI client setup (right). -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.3*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Server">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" Style="{StaticResource DetailLabel}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DetailValue}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.SuccessForeground}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.ErrorForeground}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Stopped">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.SecondaryForeground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="SQL Server:" Style="{StaticResource DetailLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServerName}" Style="{StaticResource DetailValue}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Default database:" Style="{StaticResource DetailLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DefaultDatabaseText}" Style="{StaticResource DetailValue}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Signs in with:" Style="{StaticResource DetailLabel}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AuthenticationText}" Style="{StaticResource DetailValue}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Port:" Style="{StaticResource DetailLabel}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Port, TargetNullValue='-'}" Style="{StaticResource DetailValue}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Endpoint:" Style="{StaticResource DetailLabel}" />
                    <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,2">
                        <Button DockPanel.Dock="Right"
                                Content="Copy"
                                Style="{StaticResource CopyButton}"
                                Command="{Binding CopyEndpointCommand}"
                                ToolTip="Copy the endpoint URL" />
                        <TextBox Text="{Binding Endpoint, Mode=OneWay, TargetNullValue='-'}" Style="{StaticResource CodeBox}" />
                    </DockPanel>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Transport:" Style="{StaticResource DetailLabel}" />
                    <TextBlock Grid.Row="6" Grid.Column="1"
                               Text="Streamable HTTP, localhost only (127.0.0.1)"
                               Style="{StaticResource DetailValue}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Started:" Style="{StaticResource DetailLabel}" />
                    <TextBlock Grid.Row="7" Grid.Column="1"
                               Text="{Binding StartedAt, StringFormat='{}{0:HH:mm:ss}', TargetNullValue='-'}"
                               Style="{StaticResource DetailValue}" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Tool calls:" Style="{StaticResource DetailLabel}" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding CallCount}" Style="{StaticResource DetailValue}" />

                    <!-- Read-only by default; turning write-access on asks for confirmation. -->
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Access:" Style="{StaticResource DetailLabel}" />
                    <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,3">
                        <CheckBox Content="Allow write-access (AI can change data)"
                                  IsChecked="{Binding IsReadWrite, Mode=TwoWay}"
                                  ToolTip="Off: only reading queries are allowed and every batch is rolled back. On: any T-SQL runs. Takes effect immediately." />
                        <TextBlock Text="{Binding AccessText}" Margin="0,3,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.SecondaryForeground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReadWrite}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.ErrorForeground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Connect an AI client">
                <StackPanel Margin="6">
                    <TextBlock Text="Claude Code - run in a terminal:" Style="{StaticResource DetailLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Copy"
                                Style="{StaticResource CopyButton}"
                                Command="{Binding CopyClaudeCommandCommand}" />
                        <TextBox Text="{Binding ClaudeCommand, Mode=OneWay}" Style="{StaticResource CodeBox}" />
                    </DockPanel>

                    <TextBlock Text="Codex - add to ~/.codex/config.toml:" Margin="0,10,12,3" Style="{StaticResource DetailLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Copy"
                                Style="{StaticResource CopyButton}"
                                Command="{Binding CopyCodexConfigCommand}" />
                        <TextBox Text="{Binding CodexConfig, Mode=OneWay}"
                                 Style="{StaticResource CodeBox}"
                                 AcceptsReturn="True"
                                 MinLines="2" />
                    </DockPanel>

                    <TextBlock Text="Tools: list_databases, list_tables, describe_table, execute_query"
                               Margin="0,10,0,0"
                               Style="{StaticResource DetailValue}" />

                    <!-- Data leaving the machine: make it explicit. -->
                    <TextBlock Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.ErrorForeground}"
                               Text="Query results are sent to the AI client and its model provider. With write-access, execute_query can change data, so review what the AI runs. Never paste passwords, API keys, tokens or connection strings into the chat." />

                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding CopyMessage}"
                               Foreground="{DynamicResource Theme.SuccessForeground}" />
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Activity log header. -->
        <DockPanel Grid.Row="2" Margin="0,10,0,4">
            <Button DockPanel.Dock="Right"
                    Content="Clear"
                    Padding="10,2"
                    Command="{Binding ClearActivityCommand}"
                    ToolTip="Clear the activity log" />
            <TextBlock Text="Activity (newest first)" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <!-- One row per tool call. -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Activity}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="70" />
                <DataGridTextColumn Header="Tool" Binding="{Binding ToolName}" Width="110" />
                <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="110" />
                <DataGridTemplateColumn Header="Detail" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DetailPreview}"
                                       ToolTip="{Binding Detail}"
                                       FontFamily="Consolas"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Result" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Outcome}"
                                       ToolTip="{Binding Outcome}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.ErrorForeground}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Duration" Binding="{Binding ElapsedText}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
