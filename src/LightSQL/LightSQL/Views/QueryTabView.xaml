<UserControl x:Class="LightSQL.Views.QueryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LightSQL.Views"
             xmlns:controls="clr-namespace:LightSQL.Controls">

    <!-- The content of one query tab (DataContext: QueryTabViewModel):
         the SQL editor over its own Results / Messages. One instance exists per tab
         and is kept alive while the tab is open, so undo history, caret, scroll and
         splitter position survive switching between tabs. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" MinHeight="80" />
            <RowDefinition Height="5" />
            <RowDefinition Height="1*" MinHeight="60" />
        </Grid.RowDefinitions>

        <!-- Editor options come from the main window's view model (shared by all tabs). -->
        <views:SqlEditorControl x:Name="SqlEditor"
                                Grid.Row="0"
                                DocumentText="{Binding EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedText="{Binding SelectedText, Mode=OneWayToSource}"
                                CaretLine="{Binding CaretLine, Mode=OneWayToSource}"
                                CaretColumn="{Binding CaretColumn, Mode=OneWayToSource}"
                                ShowLineNumbers="{Binding DataContext.ShowLineNumbers, RelativeSource={RelativeSource AncestorType=Window}}"
                                EditorFontSize="{Binding DataContext.EditorFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />

        <GridSplitter Grid.Row="1"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#FFE0E0E0" />

        <TabControl Grid.Row="2"
                    SelectedIndex="{Binding Results.SelectedTabIndex}">
            <TabItem Header="Results">
                <!-- The grids fill the visible area (one grid = whole pane, several share it);
                     the ScrollViewer only scrolls once they would be shorter than MinItemHeight. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Results.ResultViews}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:ResultGridsPanel MinItemHeight="100"
                                                           ViewportHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DataGrid ItemsSource="{Binding}"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Messages">
                <TextBox Text="{Binding Results.Messages, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
