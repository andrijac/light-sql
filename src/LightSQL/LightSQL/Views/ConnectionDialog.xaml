<Window x:Class="LightSQL.Views.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LightSQL.Converters"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="620"
        Title="Connect to Server">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Saved connections -->
        <GroupBox Grid.Column="0"
                  Header="Saved connections"
                  Margin="0,0,12,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <Button Content="Delete"
                            Width="70"
                            Command="{Binding DeleteSelectedCommand}" />
                </StackPanel>

                <!-- Selecting a connection loads it into the form; double-click connects. -->
                <ListBox x:Name="SavedConnectionsList"
                         ItemsSource="{Binding SavedConnections}"
                         SelectedItem="{Binding SelectedSavedConnection}"
                         DisplayMemberPath="Name"
                         MouseDoubleClick="SavedConnectionsList_MouseDoubleClick" />
            </DockPanel>
        </GroupBox>

        <!-- Connection details -->
        <StackPanel Grid.Column="1">

            <CheckBox Content="Use a .NET connection string"
                      IsChecked="{Binding UseRawConnectionString}"
                      Margin="0,0,0,8" />

            <!-- Form mode -->
            <StackPanel Visibility="{Binding UseRawConnectionString, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="Server name" />
                <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,2,0,8" />

                <TextBlock Text="Authentication" />
                <ComboBox ItemsSource="{Binding AuthenticationTypes}"
                          SelectedItem="{Binding AuthenticationType}"
                          Margin="0,2,0,8" />

                <TextBlock Text="Login" />
                <TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsSqlServerAuth}"
                         Margin="0,2,0,8" />

                <TextBlock Text="Password" />
                <PasswordBox x:Name="PasswordBox"
                             IsEnabled="{Binding IsSqlServerAuth}"
                             Margin="0,2,0,8" />

                <TextBlock Text="Database (optional)" />
                <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,2,0,8" />

                <CheckBox Content="Encrypt connection"
                          IsChecked="{Binding Encrypt}"
                          Margin="0,0,0,4" />
                <CheckBox Content="Trust server certificate"
                          IsChecked="{Binding TrustServerCertificate}"
                          Margin="0,0,0,8" />
            </StackPanel>

            <!-- Raw connection string mode -->
            <StackPanel Visibility="{Binding UseRawConnectionString, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Connection string" />
                <TextBox Text="{Binding RawConnectionString, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="80"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,2,0,8" />

                <TextBlock Text="Password (optional, used if not in the string)" />
                <PasswordBox x:Name="RawPasswordBox"
                             Margin="0,2,0,8" />
            </StackPanel>

            <Separator Margin="0,4" />

            <TextBlock Text="Save as (name)" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,2,0,8" />

            <CheckBox Content="Save this connection"
                      IsChecked="{Binding SaveConnection}"
                      Margin="0,0,0,4" />
            <CheckBox Content="Save password (encrypted with Windows DPAPI)"
                      IsChecked="{Binding SavePassword}"
                      Margin="0,0,0,8" />

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="#FF444444"
                       MinHeight="18"
                       Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Test"
                        Width="90"
                        Margin="0,0,8,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Click="TestButton_Click" />
                <Button Content="Connect"
                        Width="90"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="ConnectButton_Click" />
                <Button Content="Cancel"
                        Width="90"
                        IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
