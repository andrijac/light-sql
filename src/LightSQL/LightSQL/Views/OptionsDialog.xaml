<Window x:Class="LightSQL.Views.OptionsDialog"
        Style="{DynamicResource Theme.WindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="520"
        Title="Options">

    <StackPanel Margin="16">

        <GroupBox Header="Appearance">
            <StackPanel Orientation="Horizontal" Margin="4,8">
                <TextBlock Text="Theme"
                           VerticalAlignment="Center"
                           Width="70" />
                <!-- Selecting a theme previews it at once; Cancel restores the old one. -->
                <ComboBox Width="240"
                          ItemsSource="{Binding Themes}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Theme"
                          SelectedValue="{Binding Theme}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Safety" Margin="0,8,0,0">
            <CheckBox Content="Warn before executing UPDATE or DELETE without a WHERE clause"
                      IsChecked="{Binding WarnOnUpdateDeleteWithoutWhere}"
                      Margin="4,8" />
        </GroupBox>

        <GroupBox Header="Editor" Margin="0,8,0,0">
            <StackPanel Margin="4,8">
                <CheckBox Content="Show line numbers"
                          IsChecked="{Binding ShowLineNumbers}"
                          Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Font size"
                               VerticalAlignment="Center"
                               Width="70" />
                    <Slider Minimum="8"
                            Maximum="24"
                            Width="200"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding EditorFontSize}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{Binding EditorFontSize, StringFormat={}{0:N0} pt}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Save"
                    Width="90"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="SaveButton_Click" />
            <Button Content="Cancel"
                    Width="90"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
