<Window x:Class="LightSQL.Views.OptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="520"
        Title="Options">

    <StackPanel Margin="16">

        <GroupBox Header="Safety">
            <CheckBox Content="Warn before executing UPDATE or DELETE without a WHERE clause"
                      IsChecked="{Binding WarnOnUpdateDeleteWithoutWhere}"
                      Margin="4,8" />
        </GroupBox>

        <GroupBox Header="Saved queries" Margin="0,8,0,0">
            <Grid Margin="4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding QueriesFolder, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Browse..."
                        Width="90"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseQueriesFolderCommand}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Editor" Margin="0,8,0,0">
            <StackPanel Margin="4,8">
                <CheckBox Content="Show line numbers"
                          IsChecked="{Binding ShowLineNumbers}"
                          Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Font size"
                               VerticalAlignment="Center"
                               Width="70" />
                    <Slider Minimum="8"
                            Maximum="24"
                            Width="200"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding EditorFontSize}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{Binding EditorFontSize, StringFormat={}{0:N0} pt}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Save"
                    Width="90"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="SaveButton_Click" />
            <Button Content="Cancel"
                    Width="90"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
