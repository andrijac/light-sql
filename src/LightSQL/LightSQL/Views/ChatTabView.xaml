<UserControl x:Class="LightSQL.Views.ChatTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LightSQL.Converters"
             xmlns:models="clr-namespace:LightSQL.Models">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <converters:InverseBooleanConverter x:Key="InverseBoolean" />
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Provider + model selection and the access mode. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">

            <!-- Pick the AI provider and model; the model box is editable. -->
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Provider"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox DockPanel.Dock="Left"
                          Width="190"
                          ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding SelectedProvider}"
                          DisplayMemberPath="DisplayName"
                          ToolTip="The AI service the chat sends to" />
                <TextBlock Text="Model"
                           VerticalAlignment="Center"
                           Margin="12,0,6,0" />
                <ComboBox IsEditable="True"
                          ItemsSource="{Binding Models}"
                          Text="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Pick a suggested model or type any model the provider offers" />
            </DockPanel>

            <!-- Access mode: read-only by default; turning write-access on asks for confirmation. -->
            <DockPanel>
                <CheckBox DockPanel.Dock="Right"
                          Content="Allow write-access"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsWriteAccess}"
                          ToolTip="Let the chat change data (asks for confirmation)" />
                <TextBlock Text="{Binding AccessText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.SecondaryForeground}" />
            </DockPanel>

        </StackPanel>

        <!-- Transcript. -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource Theme.ControlBorder}"
                BorderThickness="1">
            <DockPanel>

                <!-- Transcript toolbar: copy the whole conversation (without tool calls). -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource Theme.ControlBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="4">
                    <Button HorizontalAlignment="Right"
                            Content="Copy conversation"
                            Padding="8,2"
                            Command="{Binding CopyConversationCommand}"
                            ToolTip="Copy the whole conversation to the clipboard (without tool calls)" />
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}" Margin="8">
                        <ItemsControl.Resources>

                            <!-- A user, assistant or error line, with a per-message Copy. -->
                            <DataTemplate DataType="{x:Type models:ChatMessage}">
                                <StackPanel Margin="0,0,0,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="Copy"
                                                FontSize="10"
                                                Padding="6,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource Theme.SecondaryForeground}"
                                                Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Copy this message to the clipboard" />
                                        <TextBlock Text="{Binding Author}"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Theme.SecondaryForeground}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.ErrorForeground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>

                            <!-- The tool calls for one turn: collapsed, header is the current tool. -->
                            <DataTemplate DataType="{x:Type models:ChatToolGroup}">
                                <StackPanel Margin="0,0,0,10">
                                    <Button HorizontalAlignment="Left"
                                            Padding="6,2"
                                            Command="{Binding ToggleCommand}"
                                            ToolTip="Show or hide the tool calls the assistant made">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Width="12"
                                                       Foreground="{DynamicResource Theme.SecondaryForeground}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#x25B8;" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Text" Value="&#x25BE;" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Title}"
                                                       FontFamily="Consolas"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding Calls}"
                                                  Margin="18,4,0,0"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:ChatToolCall}">
                                                <TextBlock Text="{Binding Detail}"
                                                           TextWrapping="Wrap"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Margin="0,0,0,2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Theme.SecondaryForeground}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.ErrorForeground}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>

                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Input. -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right"
                    Content="Stop"
                    Width="70"
                    Margin="8,0,0,0"
                    Command="{Binding StopCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
            <Button DockPanel.Dock="Right"
                    Content="Send"
                    Width="70"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    Command="{Binding SendCommand}" />
            <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
                     ToolTip="Ask about this database" />
        </DockPanel>
    </Grid>
</UserControl>
