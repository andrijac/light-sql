<UserControl x:Class="LightSQL.Views.SqlEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit">
    <!-- Hosts the AvalonEdit text editor configured for SQL editing. Colours come
         from the theme palette; syntax colours are applied in code-behind. -->
    <avalon:TextEditor x:Name="Editor"
                       Background="{DynamicResource Theme.Editor.Background}"
                       Foreground="{DynamicResource Theme.Editor.Foreground}"
                       LineNumbersForeground="{DynamicResource Theme.Editor.LineNumbers}"
                       ShowLineNumbers="True"
                       FontFamily="Consolas"
                       FontSize="13"
                       WordWrap="False"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto" />
</UserControl>
