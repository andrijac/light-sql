<!--
    Classic palette: the Windows Forms look - grey (#F0F0F0) control surfaces,
    white inputs, square corners, blue selection with white text, yellow tooltips.
    Defines the same keys as every other palette (see Light.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="Theme.Name">Classic</sys:String>

    <CornerRadius x:Key="Theme.CornerRadius">0</CornerRadius>

    <!-- Window and text -->
    <SolidColorBrush x:Key="Theme.WindowBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Theme.Foreground" Color="#FF000000" />
    <SolidColorBrush x:Key="Theme.SecondaryForeground" Color="#FF6D6D6D" />
    <SolidColorBrush x:Key="Theme.DisabledForeground" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="Theme.ErrorForeground" Color="#FFC00000" />
    <SolidColorBrush x:Key="Theme.SuccessForeground" Color="#FF006400" />

    <!-- Surfaces and inputs -->
    <SolidColorBrush x:Key="Theme.PanelBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.ControlBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.ControlBorder" Color="#FF7A7A7A" />
    <SolidColorBrush x:Key="Theme.ControlHoverBorder" Color="#FF0078D7" />
    <SolidColorBrush x:Key="Theme.FocusBorder" Color="#FF0078D7" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Theme.Accent" Color="#FF0078D7" />
    <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFFFF" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="Theme.ButtonBackground" Color="#FFE1E1E1" />
    <SolidColorBrush x:Key="Theme.ButtonBorder" Color="#FFADADAD" />
    <SolidColorBrush x:Key="Theme.ButtonHoverBackground" Color="#FFE5F1FB" />
    <SolidColorBrush x:Key="Theme.ButtonPressedBackground" Color="#FFCCE4F7" />

    <!-- Hover and selection -->
    <SolidColorBrush x:Key="Theme.HoverBackground" Color="#FFE5F3FF" />
    <SolidColorBrush x:Key="Theme.SelectionBackground" Color="#FF0078D7" />
    <SolidColorBrush x:Key="Theme.SelectionForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.InactiveSelectionBackground" Color="#FFD9D9D9" />

    <!-- Menus, toolbar, status bar -->
    <SolidColorBrush x:Key="Theme.MenuBarBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Theme.MenuBackground" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="Theme.MenuBorder" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="Theme.ToolBarBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Theme.StatusBarBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Theme.StatusBarForeground" Color="#FF000000" />

    <!-- Tabs -->
    <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Theme.TabBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#FFE5F1FB" />
    <SolidColorBrush x:Key="Theme.TabSelectedBackground" Color="#FFFFFFFF" />

    <!-- Splitters and scroll bars -->
    <SolidColorBrush x:Key="Theme.SplitterBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Theme.ScrollBarBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Theme.ScrollBarThumb" Color="#FFCDCDCD" />
    <SolidColorBrush x:Key="Theme.ScrollBarThumbHover" Color="#FFA6A6A6" />

    <!-- Result grids (DataGridView look) -->
    <SolidColorBrush x:Key="Theme.GridHeaderBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Theme.GridLines" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="Theme.GridAlternateRowBackground" Color="#FFFFFFFF" />

    <!-- Tooltips (classic info yellow) -->
    <SolidColorBrush x:Key="Theme.ToolTipBackground" Color="#FFFFFFE1" />
    <SolidColorBrush x:Key="Theme.ToolTipForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="Theme.ToolTipBorder" Color="#FF767676" />

    <!-- SQL editor (SSMS colours) -->
    <SolidColorBrush x:Key="Theme.Editor.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.Editor.Foreground" Color="#FF000000" />
    <SolidColorBrush x:Key="Theme.Editor.LineNumbers" Color="#FF2B91AF" />
    <SolidColorBrush x:Key="Theme.Editor.Selection" Color="#FF99C9EF" />

    <!-- SQL syntax highlighting -->
    <SolidColorBrush x:Key="Theme.Syntax.Comment" Color="#FF008000" />
    <SolidColorBrush x:Key="Theme.Syntax.String" Color="#FFFF0000" />
    <SolidColorBrush x:Key="Theme.Syntax.Keyword" Color="#FF0000FF" />
    <SolidColorBrush x:Key="Theme.Syntax.DataType" Color="#FF0000FF" />
    <SolidColorBrush x:Key="Theme.Syntax.Function" Color="#FFFF00FF" />
    <SolidColorBrush x:Key="Theme.Syntax.Variable" Color="#FF000000" />
    <SolidColorBrush x:Key="Theme.Syntax.Number" Color="#FF000000" />
</ResourceDictionary>
