<!--
    Light palette: a modern light theme.

    Every palette (Light, Dark, Classic, Gradient) defines exactly the same keys;
    Themes/Controls.xaml and the views use them only through DynamicResource, so
    ThemeService can swap palettes at runtime. When you add a key, add it to every
    palette (a unit test checks this).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Identifies the palette dictionary (see ThemeService.ThemeNameKey). -->
    <sys:String x:Key="Theme.Name">Light</sys:String>

    <!-- Rounding of buttons, inputs and other boxes. -->
    <CornerRadius x:Key="Theme.CornerRadius">3</CornerRadius>

    <!-- Window and text -->
    <SolidColorBrush x:Key="Theme.WindowBackground" Color="#FFF5F6F8" />
    <SolidColorBrush x:Key="Theme.Foreground" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Theme.SecondaryForeground" Color="#FF6B6B6B" />
    <SolidColorBrush x:Key="Theme.DisabledForeground" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="Theme.ErrorForeground" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="Theme.SuccessForeground" Color="#FF107C10" />

    <!-- Surfaces and inputs -->
    <SolidColorBrush x:Key="Theme.PanelBackground" Color="#FFFAFAFB" />
    <SolidColorBrush x:Key="Theme.ControlBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.ControlBorder" Color="#FFC8CCD2" />
    <SolidColorBrush x:Key="Theme.ControlHoverBorder" Color="#FF8A9099" />
    <SolidColorBrush x:Key="Theme.FocusBorder" Color="#FF0067C0" />

    <!-- Accent (checked boxes, focus, slider, selected tab marker) -->
    <SolidColorBrush x:Key="Theme.Accent" Color="#FF0067C0" />
    <SolidColorBrush x:Key="Theme.AccentForeground" Color="#FFFFFFFF" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="Theme.ButtonBackground" Color="#FFFDFDFD" />
    <SolidColorBrush x:Key="Theme.ButtonBorder" Color="#FFC8CCD2" />
    <SolidColorBrush x:Key="Theme.ButtonHoverBackground" Color="#FFEEF3FA" />
    <SolidColorBrush x:Key="Theme.ButtonPressedBackground" Color="#FFDCE6F4" />

    <!-- Hover and selection in lists, trees, grids and menus -->
    <SolidColorBrush x:Key="Theme.HoverBackground" Color="#FFE8EEF7" />
    <SolidColorBrush x:Key="Theme.SelectionBackground" Color="#FFCCE0F7" />
    <SolidColorBrush x:Key="Theme.SelectionForeground" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Theme.InactiveSelectionBackground" Color="#FFE5E7EB" />

    <!-- Menus, toolbar, status bar -->
    <SolidColorBrush x:Key="Theme.MenuBarBackground" Color="#FFF5F6F8" />
    <SolidColorBrush x:Key="Theme.MenuBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.MenuBorder" Color="#FFC8CCD2" />
    <SolidColorBrush x:Key="Theme.ToolBarBackground" Color="#FFF5F6F8" />
    <SolidColorBrush x:Key="Theme.StatusBarBackground" Color="#FF0067C0" />
    <SolidColorBrush x:Key="Theme.StatusBarForeground" Color="#FFFFFFFF" />

    <!-- Tabs -->
    <SolidColorBrush x:Key="Theme.TabStripBackground" Color="#FFF0F1F4" />
    <SolidColorBrush x:Key="Theme.TabBackground" Color="#FFE6E8EC" />
    <SolidColorBrush x:Key="Theme.TabHoverBackground" Color="#FFF3F4F6" />
    <SolidColorBrush x:Key="Theme.TabSelectedBackground" Color="#FFFFFFFF" />

    <!-- Splitters and scroll bars -->
    <SolidColorBrush x:Key="Theme.SplitterBackground" Color="#FFE1E4E8" />
    <SolidColorBrush x:Key="Theme.ScrollBarBackground" Color="#FFF0F1F3" />
    <SolidColorBrush x:Key="Theme.ScrollBarThumb" Color="#FFC2C6CC" />
    <SolidColorBrush x:Key="Theme.ScrollBarThumbHover" Color="#FF9DA3AB" />

    <!-- Result grids -->
    <SolidColorBrush x:Key="Theme.GridHeaderBackground" Color="#FFF0F1F4" />
    <SolidColorBrush x:Key="Theme.GridLines" Color="#FFE3E5E8" />
    <SolidColorBrush x:Key="Theme.GridAlternateRowBackground" Color="#FFF8F9FB" />

    <!-- Tooltips -->
    <SolidColorBrush x:Key="Theme.ToolTipBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.ToolTipForeground" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Theme.ToolTipBorder" Color="#FFC8CCD2" />

    <!-- SQL editor -->
    <SolidColorBrush x:Key="Theme.Editor.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.Editor.Foreground" Color="#FF000000" />
    <SolidColorBrush x:Key="Theme.Editor.LineNumbers" Color="#FF2B91AF" />
    <SolidColorBrush x:Key="Theme.Editor.Selection" Color="#FFADD6FF" />

    <!-- SQL syntax highlighting (names match the colours in Editor/SqlSyntax.xshd) -->
    <SolidColorBrush x:Key="Theme.Syntax.Comment" Color="#FF008000" />
    <SolidColorBrush x:Key="Theme.Syntax.String" Color="#FFA31515" />
    <SolidColorBrush x:Key="Theme.Syntax.Keyword" Color="#FF0000FF" />
    <SolidColorBrush x:Key="Theme.Syntax.DataType" Color="#FF2B91AF" />
    <SolidColorBrush x:Key="Theme.Syntax.Function" Color="#FFAA00AA" />
    <SolidColorBrush x:Key="Theme.Syntax.Variable" Color="#FF7F0055" />
    <SolidColorBrush x:Key="Theme.Syntax.Number" Color="#FFAF5F00" />
</ResourceDictionary>
